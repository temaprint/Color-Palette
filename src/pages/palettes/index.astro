---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { Palette } from 'lucide-react';
import { getAllColors } from '../../lib/colors';
import { getAllPalettes } from '../../lib/palettes';

const colors = await getAllColors();
const palettes = await getAllPalettes();
---

<Layout title="Color Palettes — ColorPalette">
  <Navbar />
  <main class="container py-12 lg:py-16">
    <div class="max-w-7xl mx-auto">
      <header class="mb-12">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 dark:text-white mb-4 tracking-tight">Color Palettes</h1>
        <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl leading-relaxed">
          Discover harmonious color combinations curated for various design needs.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {palettes.map(palette => {
          const paletteColors = palette.colors
            .map(colorSlug => colors.find(c => c.slug === colorSlug))
            .filter(Boolean);

          return (
            <a
              href={`/palettes/${palette.id}`}
              class="group card"
            >
              <div class="relative">
                <div class="flex h-44">
                  {paletteColors.map(color => color && (
                    <div
                      class="flex-1 transition-transform group-hover:scale-105 duration-500 first:rounded-tl-3xl last:rounded-tr-3xl"
                      style={{ backgroundColor: color.hexCode }}
                    />
                  ))}
                </div>
              </div>
              <div class="p-6">
                <div class="flex items-center mb-3">
                  <div class="p-1.5 rounded-lg bg-primary-50 dark:bg-primary-950/50 mr-3">
                    <Palette className="h-4 w-4 text-primary-600 dark:text-primary-400" />
                  </div>
                  <h2 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors duration-200">
                    {palette.name}
                  </h2>
                </div>
                <p class="text-gray-500 dark:text-gray-400 text-sm mb-4">{palette.description}</p>
                <div class="flex flex-wrap gap-2">
                  {palette.tags.map(tag => (
                    <span class="tag text-xs">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </main>
</Layout>
