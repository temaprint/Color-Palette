---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { ArrowLeft, Calendar, Droplet } from 'lucide-react';
import { getAllArticles } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
---

<Layout title={`${article.title} — ColorPalette`}>
  <Navbar />
  <main class="container py-12 lg:py-16">
    <div class="max-w-4xl mx-auto">
      <a
        href="/articles"
        class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 mb-8 font-medium text-sm"
      >
        <ArrowLeft className="h-4 w-4 mr-2" />
        Back to Articles
      </a>

      <article class="card overflow-hidden">
        <div
          class="h-56 w-full relative"
          style={{ backgroundColor: article.hexCode }}
        >
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent" />
        </div>

        <div class="p-6 sm:p-10">
          <div class="flex items-center gap-4 text-gray-400 dark:text-gray-500 text-sm mb-8">
            <div class="flex items-center">
              <Calendar className="h-4 w-4 mr-2" />
              <time datetime={article.date}>
                {new Date(article.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
            </div>
            <div class="flex items-center">
              <Droplet className="h-4 w-4 mr-2" style={{ color: article.hexCode }} />
              <code class="font-mono">{article.hexCode}</code>
            </div>
          </div>

          <div class="prose prose-lg prose-primary dark:prose-invert max-w-none">
            <Fragment set:html={article.content} />
          </div>
        </div>
      </article>
    </div>
  </main>
</Layout>
