---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { Calendar, ArrowRight } from 'lucide-react';
import { getAllArticles } from '../../lib/articles';

const articles = await getAllArticles();
---

<Layout title="Color Articles & Insights — ColorPalette">
  <Navbar />
  <main class="container py-12 lg:py-16">
    <div class="max-w-7xl mx-auto">
      <header class="mb-12">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 dark:text-white mb-4 tracking-tight">Color Articles & Insights</h1>
        <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl leading-relaxed">
          Explore the latest trends, insights, and stories about colors.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map(article => (
          <a
              href={`/articles/${article.slug}`}
              class="group card"
          >
            <div
                class="h-48 w-full relative"
                style={{ backgroundColor: article.hexCode }}
            >
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            </div>
            <div class="p-6">
              <div class="flex items-center text-gray-400 dark:text-gray-500 text-sm mb-4">
                <Calendar className="h-4 w-4 mr-2" />
                <time datetime={article.date}>
                  {new Date(article.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
              </div>
              <h2 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors duration-200 mb-3 line-clamp-2">
                {article.title}
              </h2>
              <p class="text-gray-500 dark:text-gray-400 text-sm mb-4 line-clamp-2">
                {article.description}
              </p>
              <div class="flex items-center text-primary-600 dark:text-primary-400 text-sm font-medium group-hover:text-primary-700 dark:group-hover:text-primary-300">
                Read more
                <ArrowRight className="h-4 w-4 ml-1.5 transition-transform group-hover:translate-x-1" />
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
