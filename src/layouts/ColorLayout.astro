---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import { ArrowLeft } from 'lucide-react';

interface Props {
  title: string;
  backLink?: string;
  backText?: string;
}

const {
  title,
  backLink = "/colors",
  backText = "Back to Colors"
} = Astro.props;
---

<Layout title={title}>
  <Navbar />
  <main class="container py-8 lg:py-12">
    <div class="max-w-6xl mx-auto">
      {backLink && (
        <a
          href={backLink}
          class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 mb-8 font-medium text-sm"
        >
          <ArrowLeft className="h-4 w-4 mr-2" />
          {backText}
        </a>
      )}
      <slot />
    </div>
  </main>
</Layout>
